---
# ansible-vault encrypt --output inventory/group_vars/all/vault.yml vault.yml.example
#
# The one secret of the whole deployment: every path, UUID and subscription
# token derives from it. Generate with: openssl rand -hex 32
vault_seed: "REPLACE_ME_openssl_rand_hex_32"

# Where Let's Encrypt sends expiry notices. Not a secret, but personal data,
# and everything else in the inventory is committed — see acme_email in
# group_vars/all/main.yml, which reads this.
vault_acme_email: "you@example.com"

# The DNS zone certificates are issued under, and credentials for its API.
# Certificates come over dns-01, so every node needs to be able to write a
# TXT record into the zone — which is why these exist and why they are the
# most dangerous thing in this deployment: a node that is broken into can
# issue a certificate for any name in the zone. Scope the key to DNS writes
# and nothing else, and rotate it if a node is ever lost.
vault_dns_zone: "example.com"
vault_spaceship_api_key: "REPLACE_ME"
vault_spaceship_api_secret: "REPLACE_ME"
