{#- All computation happens up here, above the shebang, so the whitespace
    control on these tags cannot eat into the ruleset below. -#}
{#- Hosts allowed to reach the reality port, minus ourselves. -#}
{%- set peers = (groups[firewall_peer_group] | default([])) | difference([inventory_hostname]) -%}
{%- set is_peer = inventory_hostname in groups[firewall_peer_group] | default([]) -%}
{#- Hosts that take user traffic on 80/443. -#}
{%- set ingress_hosts = [] -%}
{%- for group in firewall_ingress_groups -%}
{%-   set _ = ingress_hosts.extend(groups[group] | default([])) -%}
{%- endfor -%}
#!/usr/sbin/nft -f
{{ ansible_managed | comment }}
flush ruleset

table inet filter {
{% if is_peer and peers | length > 0 %}
    # Offshore nodes only. The domestic entry node is not in the peer group,
    # so it can never land here — "domestic egress hits angie only" is
    # structural, not a matter of operator discipline.
    set eu_peers {
        type ipv4_addr
        elements = { {{ peers | map('extract', hostvars, 'ansible_host') | join(', ') }} }
    }
{% endif %}

    chain input {
        type filter hook input priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop
        iif lo accept
        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept

{% if firewall_ssh_allowed_cidrs | length > 0 %}
        ip saddr { {{ firewall_ssh_allowed_cidrs | join(', ') }} } tcp dport {{ firewall_ssh_port | int }} accept
{% else %}
        tcp dport {{ firewall_ssh_port | int }} accept
{% endif %}

{% if inventory_hostname in ingress_hosts %}
        # User ingress: HTTP/2 over TCP and HTTP/3 over QUIC.
        tcp dport { {{ firewall_ingress_tcp_ports | join(', ') }} } accept
        udp dport { {{ firewall_ingress_udp_ports | join(', ') }} } accept
{% endif %}

{% if is_peer and peers | length > 0 %}
        # Reality link between offshore nodes on a random port.
        tcp dport {{ firewall_relay_port | int }} ip saddr @eu_peers accept
{% endif %}
    }

    chain forward { type filter hook forward priority 0; policy drop; }
    chain output  { type filter hook output  priority 0; policy accept; }
}
