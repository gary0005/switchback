{{ ansible_managed | comment }}
# Congestion control. bbr lives in a module that is not loaded by default —
# without the modprobe beside this file, the kernel silently keeps cubic and
# nothing here reports a problem.
net.core.default_qdisc = {{ common_qdisc }}
net.ipv4.tcp_congestion_control = {{ common_congestion_control }}

# Socket buffers. QUIC pushes large UDP datagrams and a two-hop chain carries
# every byte twice, so the defaults cap throughput long before the link does.
net.core.rmem_max = {{ common_socket_buffer_max | int }}
net.core.wmem_max = {{ common_socket_buffer_max | int }}
net.ipv4.tcp_rmem = 4096 87380 {{ common_socket_buffer_max | int }}
net.ipv4.tcp_wmem = 4096 65536 {{ common_socket_buffer_max | int }}
net.ipv4.udp_rmem_min = 4096
net.ipv4.udp_wmem_min = 4096

# A chain's second leg is a long-lived connection that goes quiet between
# requests. Without this the kernel throws away its congestion window every
# time it idles, and the next burst starts from scratch.
net.ipv4.tcp_slow_start_after_idle = 0

# Path MTU discovery: an intermediate link with a smaller MTU otherwise shows
# up as a stall rather than as an error.
net.ipv4.tcp_mtu_probing = 1

net.core.netdev_max_backlog = {{ common_netdev_backlog | int }}
net.core.somaxconn = {{ common_somaxconn | int }}
net.ipv4.tcp_fastopen = 3
fs.file-max = {{ common_file_max | int }}
