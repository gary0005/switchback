{{ ansible_managed | comment }}
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr

# QUIC/HTTP3 pushes large UDP datagrams: with the default buffers angie
# logs a warning and h3 throughput degrades.
net.core.rmem_max = {{ common_socket_buffer_max | int }}
net.core.wmem_max = {{ common_socket_buffer_max | int }}

net.ipv4.ip_forward = 1
net.ipv4.tcp_fastopen = 3
fs.file-max = {{ common_file_max | int }}
