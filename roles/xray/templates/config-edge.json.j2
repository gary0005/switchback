{#- Client lists are built as lists and piped through to_json: always valid JSON.
    Peer values in the outbounds below come from the inventory-level vpn_*
    names: an exit node lives in a different play, so xray's role defaults are
    not in its hostvars. -#}
{%- set c1 = [] -%}
{%- for u in xray_users if u['tier'] in xray_tier_hop1 -%}
{%-   set uuid = (vault_seed ~ ':user:' ~ u['name'] ~ ':' ~ u['rot']) | to_uuid -%}
{%-   set _ = c1.append({'id': uuid, 'email': u['name'], 'level': 0}) -%}
{%- endfor -%}
{%- set c2 = [] -%}
{%- for u in xray_users if u['tier'] in xray_tier_hop2 -%}
{%-   set uuid = (vault_seed ~ ':user:' ~ u['name'] ~ ':' ~ u['rot']) | to_uuid -%}
{%-   set _ = c2.append({'id': uuid, 'email': u['name'], 'level': 0}) -%}
{%- endfor -%}
{#- Service account for the inbound link from the domestic entry node -#}
{%- set _ = c2.append({'id': xray_node_link_uuid, 'email': 'node-ru@internal', 'level': 0}) -%}
{
  "log": { "loglevel": "warning", "access": "none" },

  "inbounds": [
    {
      "tag": "in-hop1",
      "listen": "{{ xray_socket_dir }}/hop1.sock,0666",
      "protocol": "vless",
      "settings": { "clients": {{ c1 | to_json }}, "decryption": "none" },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": { "path": "{{ xray_path_hop1 }}", "mode": "packet-up" }
      }
    },
    {
      "tag": "in-hop2",
      "listen": "{{ xray_socket_dir }}/hop2.sock,0666",
      "protocol": "vless",
      "settings": { "clients": {{ c2 | to_json }}, "decryption": "none" },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": { "path": "{{ xray_path_hop2 }}", "mode": "packet-up" }
      }
    }
  ],

  "outbounds": [
    { "tag": "direct", "protocol": "freedom" },
{% for h in groups[xray_exit_group] | default([]) %}
    {
      "tag": "to-exit-{{ h }}",
      "protocol": "vless",
      "settings": {
        "vnext": [{
          "address": "{{ hostvars[h]['ansible_host'] }}",
          "port": {{ hostvars[h]['vpn_relay_port'] | int }},
          "users": [{ "id": "{{ xray_relay_uuid }}", "encryption": "none", "flow": "xtls-rprx-vision" }]
        }]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "{{ xray_reality_server_names[0] }}",
          "fingerprint": "chrome",
          "publicKey": "{{ __xray_reality[h][1] }}",
          "shortId": "{{ hostvars[h]['vpn_reality_short_id'] }}"
        }
      }
    },
{% endfor %}
    { "tag": "block", "protocol": "blackhole" }
  ],

  "routing": {
    "domainStrategy": "AsIs",
    "balancers": [
      { "tag": "exits", "selector": ["to-exit-"] }
    ],
    "rules": [
      { "type": "field", "protocol": ["bittorrent"], "outboundTag": "block" },
      { "type": "field", "ip": ["geoip:private"], "outboundTag": "block" },
      { "type": "field", "inboundTag": ["in-hop1"], "outboundTag": "direct" },
      { "type": "field", "inboundTag": ["in-hop2"], "balancerTag": "exits" }
    ]
  }
}
