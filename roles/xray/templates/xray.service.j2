{{ ansible_managed | comment }}
[Unit]
Description=Xray
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ xray_bin }} run -config {{ xray_dir }}/config.json
Restart=on-failure
RestartSec=3
LimitNOFILE={{ xray_service_limit_nofile | int }}

# IMPORTANT: PrivateTmp=yes namespaces both /dev/shm and /tmp, which hides
# the unix socket from angie. Sockets live in RuntimeDirectory with mode
# 0755 so angie can traverse to them.
PrivateTmp=no
RuntimeDirectory={{ xray_socket_dir | basename }}
RuntimeDirectoryMode=0755

AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
