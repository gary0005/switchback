{#- One entry per (chain, ALPN). A chain is addressed at the node that fronts
    it — its `via` — because that is where the user's TLS terminates; what
    happens after that is the server's business and nothing in the link
    describes it. Peer values use the inventory-level vpn_* names: `via` may
    belong to another play, where role defaults are not in scope. -#}
{%- set uuid = (vault_seed ~ ':user:' ~ item['name'] ~ ':' ~ item['rot']) | to_uuid -%}
{%- set uris = [] -%}
{#- One place that knows the URI shape, so chains cannot drift apart. -#}
{%- macro vless_uri(domain, path, alpn, label) -%}
{%- set params = {
      'encryption': 'none',
      'security': 'tls',
      'sni': domain,
      'fp': 'chrome',
      'alpn': alpn,
      'type': 'xhttp',
      'host': domain,
      'path': path,
      'mode': 'packet-up',
    } -%}
vless://{{ uuid }}@{{ domain }}:443?{{ params | urlencode }}#{{ label }}
{%- endmacro -%}
{%- for c in subscription_chains -%}
{%-   set d = subscription_chain_data[c.name] -%}
{%-   if d['kind'] in subscription_tier_kinds[item['tier']] -%}
{%-     set dom = hostvars[c.via]['vpn_domain'] -%}
{%-     for alpn in subscription_alpns -%}
{%-       set _ = uris.append(vless_uri(dom, d['path_in'], alpn, c.name ~ '-' ~ alpn)) -%}
{%-     endfor -%}
{%-   endif -%}
{%- endfor -%}
{{ uris | join('\n') | b64encode }}
