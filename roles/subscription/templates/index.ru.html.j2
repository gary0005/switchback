{%- set token = ((vault_seed ~ ':sub:' ~ item['name'] ~ ':' ~ item['rot']) | hash('sha256'))[:32] -%}
{#- Routes are counted, not named: the node names are internal, and a user's
    page is the last place to describe the topology. -#}
{%- set kinds = subscription_tier_kinds[item['tier']] -%}
{%- set avail = subscription_chains | map(attribute='name')
                | map('extract', subscription_chain_data)
                | selectattr('kind', 'in', kinds) | list -%}
{%- set n_multi = avail | selectattr('kind', 'eq', 'multi') | list | length -%}
{%- set n_test = avail | selectattr('kind', 'eq', 'test') | list | length -%}
<!doctype html>
<!-- {{ ansible_managed }} -->
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Подписка</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 44rem; margin: 3rem auto;
         padding: 0 1.25rem; line-height: 1.6; color: #1a1a1a; }
  code { background: #f3f3f1; padding: .15rem .35rem; border-radius: 4px;
         word-break: break-all; font-size: .9em; }
  .row { display: flex; gap: .5rem; align-items: center; margin: .4rem 0; }
  button { border: 1px solid #ccc; background: #fff; border-radius: 6px;
           padding: .3rem .7rem; cursor: pointer; font: inherit; }
  small { color: #666; }
</style>
</head>
<body>
<h1>Подписка</h1>

<p>Вставьте эту ссылку в клиент как <em>subscription</em> — конфиги обновятся сами.</p>
<div class="row">
  <code id="sub">https://{{ subscription_domain }}{{ subscription_prefix }}/{{ token }}</code>
  <button onclick="copy('sub')">Копировать</button>
</div>

<p><small>
  Клиенты: v2rayNG или Happ (Android), Streisand или Shadowrocket (iOS),
  Nekoray или v2rayN (десктоп).
</small></p>

<h2>Что внутри</h2>
<ul>
{% if n_multi > 0 %}
  <li><b>Двуххоповых маршрутов: {{ n_multi }}</b> — трафик выходит не там, где
      вошёл. Их и используйте; если один тормозит, попробуйте другой.</li>
{% endif %}
{% if n_test > 0 %}
  <li><b>Однохоповых маршрутов: {{ n_test }}</b> — только для проверки:
      выходной адрес совпадает с входным.</li>
{% endif %}
  <li>Каждый маршрут идёт в двух вариантах: <b>h2</b> и <b>h3</b>.
      <b>Берите h2.</b> h3 работает поверх UDP, а его почти везде режут:
      соединение установится, но скорость упадёт в несколько раз, а на слабом
      канале связь просто не удержится. h3 стоит пробовать, только если h2
      чем-то не устроил.</li>
</ul>

<script>
function copy(id) {
  navigator.clipboard.writeText(document.getElementById(id).textContent);
}
</script>
</body>
</html>
