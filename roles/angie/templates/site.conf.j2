{{ ansible_managed | comment }}
{% set is_edge = inventory_hostname in groups[angie_edge_group] | default([]) %}
{% set hops = ['hop1', 'hop2'] if is_edge else ['hop3'] %}
{% for hop in hops %}
upstream xray_{{ hop }} {
    server unix:{{ angie_socket_dir }}/{{ hop }}.sock;
    keepalive {{ angie_upstream_keepalive | int }};
}
{% endfor %}

server {
    listen 443 ssl reuseport;
    listen 443 quic reuseport;
    listen [::]:443 ssl reuseport;
    listen [::]:443 quic reuseport;

    http2 on;
    server_name {{ angie_domain }};

    ssl_certificate     {{ angie_cert_dir }}/fullchain.pem;
    ssl_certificate_key {{ angie_cert_dir }}/privkey.pem;

    add_header Alt-Svc 'h3=":443"; ma=86400' always;

    # XHTTP sends bodies of unknown length — the default 1M limit tears the
    # upload stream on the first sizeable request.
    client_max_body_size {{ angie_client_max_body_size }};

{% for hop in hops %}
    location {{ angie_hop_paths[hop] }} {
        proxy_pass              http://xray_{{ hop }};
        proxy_http_version      1.1;
        proxy_set_header        Connection "";
        proxy_set_header        Host $host;
        proxy_set_header        X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $scheme;
        # Without these two, XHTTP simply hangs: angie buffers the stream
        # instead of forwarding it straight through.
        proxy_buffering         off;
        proxy_request_buffering off;
        proxy_read_timeout      {{ angie_proxy_timeout }};
        proxy_send_timeout      {{ angie_proxy_timeout }};
    }

{% endfor %}
    location {{ angie_sub_prefix }}/ {
        alias {{ angie_sub_root }}/;
        default_type text/plain;
        add_header profile-update-interval "12" always;
        add_header Cache-Control "no-store" always;
    }

    location / {
        root {{ angie_decoy_root }};
        index index.html;
    }
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}
